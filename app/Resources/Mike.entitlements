<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime blocks the microphone unless the app asks for it. Not sandboxed: the app shares
	     ~/.mike with bridge.py and the agent skills, and starts afplay for the cue sounds. -->
	<key>com.apple.security.device.audio-input</key><true/>
</dict>
</plist>
